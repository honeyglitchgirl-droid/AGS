{
  "$id": "https://ags-sci.local/schemas/equation-record-1.2.0.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "source_level": {
            "const": "research"
          }
        },
        "required": [
          "source_level"
        ]
      },
      "then": {
        "required": [
          "source_ids",
          "relation_type",
          "status",
          "source_locator",
          "unit_system"
        ]
      }
    }
  ],
  "description": "Backward-compatible v1 schema. Optional research metadata is required only for inert RS records; all v1.0/v1.1 records remain valid and unchanged.",
  "properties": {
    "aliases": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 32,
      "type": "array",
      "uniqueItems": true
    },
    "assumptions": {
      "items": {
        "maxLength": 512,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 16,
      "type": "array",
      "uniqueItems": true
    },
    "conventions": {
      "items": {
        "maxLength": 512,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 16,
      "type": "array",
      "uniqueItems": true
    },
    "curriculum_level": {
      "pattern": "^[a-z][a-z0-9_]{0,63}$",
      "type": "string"
    },
    "domain": {
      "enum": [
        "mathematics",
        "physics"
      ]
    },
    "formula": {
      "maxLength": 4096,
      "minLength": 1,
      "type": "string"
    },
    "id": {
      "pattern": "^(MATH|PHY)-(?:(?:UG|GR|RS)-)?[A-Z0-9]+-[0-9]{6}$",
      "type": "string"
    },
    "relation_type": {
      "enum": [
        "identity",
        "definition",
        "equation",
        "operator_relation",
        "transformation",
        "differential_system",
        "conservation_law",
        "variational_principle",
        "boundary_condition",
        "constitutive_relation",
        "inequality",
        "recurrence",
        "canonical_relation",
        "symmetry_relation",
        "asymptotic_relation",
        "integral_relation",
        "spectral_relation",
        "constraint",
        "commutation_relation",
        "evolution_equation"
      ]
    },
    "source_ids": {
      "items": {
        "pattern": "^[A-Z0-9][A-Z0-9-]{1,95}$",
        "type": "string"
      },
      "maxItems": 8,
      "type": "array",
      "uniqueItems": true
    },
    "source_level": {
      "pattern": "^[a-z][a-z0-9_]{0,63}$",
      "type": "string"
    },
    "source_locator": {
      "maxLength": 1024,
      "minLength": 1,
      "type": "string"
    },
    "status": {
      "enum": [
        "established",
        "model_dependent",
        "conjectural"
      ]
    },
    "subtopic": {
      "maxLength": 96,
      "minLength": 1,
      "type": "string"
    },
    "symbols": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 64,
      "type": "array",
      "uniqueItems": true
    },
    "topic": {
      "type": "string"
    },
    "unit_system": {
      "enum": [
        "not_applicable",
        "si",
        "natural",
        "geometrized",
        "atomic",
        "gaussian_cgs",
        "heaviside_lorentz",
        "dimensionless",
        "mixed",
        "source_defined"
      ]
    }
  },
  "required": [
    "id",
    "domain",
    "topic",
    "formula"
  ],
  "schema_version": "1.2.0",
  "security": {
    "dynamic_import_from_data": "forbidden",
    "execution": "forbidden",
    "formula_semantics": "opaque_text"
  },
  "title": "AGS-Sci Equation Reference Record",
  "type": "object"
}
